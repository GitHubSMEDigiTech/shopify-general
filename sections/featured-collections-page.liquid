{%- assign per_page = section.settings.products_per_page | default: 8 -%}
{%- if per_page < 1 -%}
  {%- assign per_page = 1 -%}
{%- endif -%}
{%- if per_page > 50 -%}
  {%- assign per_page = 50 -%}
{%- endif -%}

{%- paginate collection.products by per_page -%}
  <div data-page-products data-total-pages="{{ paginate.pages }}" data-current-page="{{ paginate.current_page }}">
    {%- for product in collection.products -%}
      <div class="featured-collections-list__product" role="listitem" data-product-item>
        {%- render 'product-item', product: product, show_add_to_cart: section.settings.show_quick_buy, show_quick_inventory: section.settings.show_quick_inventory -%}
      </div>
    {%- endfor -%}
  </div>

  <div data-page-pagination>
    {%- render 'pagination', paginate: paginate -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Featured collections page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "info": "Deve coincidere con lo stesso valore in Featured collections list",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "label": "Show quick buy",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_inventory",
      "label": "Show Inventory",
      "default": false
    }
  ]
}
{% endschema %}
