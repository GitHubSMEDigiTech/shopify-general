{%- comment -%}
  Section ausiliaria: rende una singola pagina di prodotti di una collezione,
  richiesta via Section Rendering API da featured-collections-list.
{%- endcomment -%}

{%- assign per_page = 8 -%}
{%- if request.get.per != blank -%}
  {%- assign per_page = request.get.per | times: 1 -%}
{%- endif -%}
{%- if per_page < 1 -%}
  {%- assign per_page = 1 -%}
{%- endif -%}
{%- if per_page > 50 -%}
  {%- assign per_page = 50 -%}
{%- endif -%}

{%- assign show_quick_buy = false -%}
{%- if request.get.quick_buy == 'true' -%}
  {%- assign show_quick_buy = true -%}
{%- endif -%}

{%- assign show_quick_inventory = false -%}
{%- if request.get.quick_inventory == 'true' -%}
  {%- assign show_quick_inventory = true -%}
{%- endif -%}

{%- paginate collection.products by per_page -%}
  <div data-page-products data-total-pages="{{ paginate.pages }}" data-current-page="{{ paginate.current_page }}">
    {%- for product in collection.products -%}
      <div class="featured-collections-list__product" role="listitem" data-product-item>
        {%- render 'product-item', product: product, show_add_to_cart: show_quick_buy, show_quick_inventory: show_quick_inventory -%}
      </div>
    {%- endfor -%}
  </div>

  <div data-page-pagination>
    {%- render 'pagination', paginate: paginate -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Featured collections page",
  "settings": []
}
{% endschema %}
