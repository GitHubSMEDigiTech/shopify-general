{% doc %}
  @prompt
    Devo mostrare in modo creativo la collezione Merch
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign merch_collection = block.settings.featured_collection %}

{% style %}
  .ai-merch-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #ffffff;
    background: #131313;
    font-family: inherit;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__hero {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #292929;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__hero-image,
  .ai-merch-editorial-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__hero-image {
    object-fit: cover;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.12) 85%), linear-gradient(0deg, rgba(0, 0, 0, 0.5), transparent 65%);
  }

  .ai-merch-editorial-{{ ai_gen_id }}__hero-content {
    position: relative;
    z-index: 1;
    width: min(760px, 100%);
    padding: clamp(28px, 6vw, 72px);
  }

  .ai-merch-editorial-{{ ai_gen_id }}__eyebrow {
    display: block;
    margin: 0 0 14px;
    color: #ff4b50;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__title {
    margin: 0;
    color: #ffffff;
    font-size: clamp(38px, 7vw, 76px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__description {
    max-width: 560px;
    margin-top: 18px;
    color: #f1f1f1;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 24px;
    padding: 0 22px;
    border: 1px solid #ff4b50;
    background: #c5161c;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__link:hover {
    background: #9f1015;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__link:focus-visible,
  .ai-merch-editorial-{{ ai_gen_id }}__product-link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__products {
    padding: 30px clamp(18px, 4vw, 48px) 38px;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__products-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 20px;
    padding-bottom: 13px;
    border-bottom: 1px solid #454545;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__products-heading h3 {
    margin: 0;
    color: #ffffff;
    font-size: 18px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__products-heading span {
    color: #d1d1d1;
    font-size: 13px;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__product-link {
    display: block;
    color: #ffffff;
    text-decoration: none;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__product-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #292929;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__product-link:hover .ai-merch-editorial-{{ ai_gen_id }}__product-media img {
    transform: scale(1.04);
  }

  .ai-merch-editorial-{{ ai_gen_id }}__product-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    padding-top: 12px;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__product-title {
    margin: 0;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__price {
    flex: 0 0 auto;
    color: #eeeeee;
    font-size: 13px;
  }

  .ai-merch-editorial-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 24px;
    border: 1px solid #454545;
    color: #eeeeee;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-merch-editorial-{{ ai_gen_id }}__hero {
      min-height: 320px;
    }

    .ai-merch-editorial-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 12px;
    }

    .ai-merch-editorial-{{ ai_gen_id }}__products-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }
  }
{% endstyle %}

<div class="ai-merch-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-merch-editorial-{{ ai_gen_id }}__hero">
    {% if merch_collection != blank and merch_collection.image != blank %}
      <img
        class="ai-merch-editorial-{{ ai_gen_id }}__hero-image"
        src="{{ merch_collection.image | image_url: width: 2000 }}"
        alt="{{ merch_collection.image.alt | default: merch_collection.title | escape }}"
        width="{{ merch_collection.image.width }}"
        height="{{ merch_collection.image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-merch-editorial-{{ ai_gen_id }}__placeholder">
        {{ 'collection-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
    <div class="ai-merch-editorial-{{ ai_gen_id }}__shade"></div>
    <div class="ai-merch-editorial-{{ ai_gen_id }}__hero-content">
      <span class="ai-merch-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</span>
      <h2 class="ai-merch-editorial-{{ ai_gen_id }}__title">
        {% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% elsif merch_collection != blank %}{{ merch_collection.title | escape }}{% else %}Merch{% endif %}
      </h2>
      {% if block.settings.show_description and merch_collection != blank and merch_collection.description != blank %}
        <div class="ai-merch-editorial-{{ ai_gen_id }}__description">{{ merch_collection.description }}</div>
      {% elsif block.settings.intro != blank %}
        <div class="ai-merch-editorial-{{ ai_gen_id }}__description">{{ block.settings.intro | escape }}</div>
      {% endif %}
      {% if merch_collection != blank %}
        <a class="ai-merch-editorial-{{ ai_gen_id }}__link" href="{{ merch_collection.url }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>

  {% if merch_collection != blank and block.settings.show_products %}
    <div class="ai-merch-editorial-{{ ai_gen_id }}__products">
      <div class="ai-merch-editorial-{{ ai_gen_id }}__products-heading">
        <h3>{{ block.settings.products_heading | escape }}</h3>
        <span>{{ merch_collection.products_count }} prodotti</span>
      </div>
      <div class="ai-merch-editorial-{{ ai_gen_id }}__grid">
        {% for merch_product in merch_collection.products limit: 4 %}
          <a class="ai-merch-editorial-{{ ai_gen_id }}__product-link" href="{{ merch_product.url }}">
            <div class="ai-merch-editorial-{{ ai_gen_id }}__product-media">
              {% if merch_product.featured_image != blank %}
                <img
                  src="{{ merch_product.featured_image | image_url: width: 700 }}"
                  alt="{{ merch_product.featured_image.alt | default: merch_product.title | escape }}"
                  width="{{ merch_product.featured_image.width }}"
                  height="{{ merch_product.featured_image.height }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-merch-editorial-{{ ai_gen_id }}__product-info">
              <h4 class="ai-merch-editorial-{{ ai_gen_id }}__product-title">{{ merch_product.title | escape }}</h4>
              <span class="ai-merch-editorial-{{ ai_gen_id }}__price">{{ merch_product.price | money }}</span>
            </div>
          </a>
        {% else %}
          <div class="ai-merch-editorial-{{ ai_gen_id }}__empty">Aggiungi prodotti alla collezione selezionata per mostrarli qui.</div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Merch editoriale",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collezione Merch"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Larghezza desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Testo introduttivo",
      "default": "Indossa la tua musica"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo personalizzato"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Descrizione alternativa",
      "default": "Scopri la selezione ufficiale di merchandising."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostra descrizione della collezione",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante",
      "default": "Scopri il merch"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Mostra prodotti in evidenza",
      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Titolo prodotti",
      "default": "Dalla collezione"
    }
  ],
  "presets": [
    {
      "name": "Merch editoriale"
    }
  ],
  "tag": null,
  "class": "merch-editorial-block"
}
{% endschema %}