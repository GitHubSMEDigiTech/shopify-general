<div class="product-item__b2b-inner">
  {% for order in customer.orders %}
    {% for line_item in order.line_items%}
      {%- if line_item.product.id == product.id -%}
        {% assign total_quantity = line_item.quantity | sum: "quantity" %}
      {%- endif -%}
    {% endfor %}
  {% endfor %}
  {{ total_quantity }}
</div>
