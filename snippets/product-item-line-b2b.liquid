<div class="product-item__price-info">
  {% if customer.orders_count > 0 %}
    {% for order in customer.orders %}
      {% for line_item in order.line_items %}
        <p>{{ line_item.product.id }}{{ product.id }}</p>
        {%- if line_item.product.id == product.id -%}
          {% assign total_quantity = total_quantity | plus: line_item.quantity %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    
    {% if total_quantity > 0 %}
      <p>{{ total_quantity }}</p>
    {% else %}
      <p>x</p>
     {%- comment -%}  <p>You have not ordered the product yet.</p> {%- endcomment -%} 
    {% endif %}
  {% endif %}
</div>
