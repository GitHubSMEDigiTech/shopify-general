<div class="product-item__price-info">
  {% if customer.orders_count > 0 %}
    {% for order in customer.orders %}
      {% for line_item in order.line_items %}
        {% if line_item.product.id == product.id %}
          {% assign total_quantity = total_quantity | plus: line_item.quantity %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    
    {% if total_quantity > 0 %}
      <p>{{ total_quantity }}</p>
    {% else %}
      {%- comment -%}  <p>x</p> {%- endcomment -%} 
    {% endif %}
  {% endif %}
</div>
