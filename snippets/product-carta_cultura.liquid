<div class="carta_cultura">
{%- if product.metafields.meta.street_date != blank -%}
    {% capture system_date %}{{'now' | date: "%Y-%m-%d"}}{% endcapture %}
    {% assign metafield_date = product.metafields.meta.street_date | date: "%Y-%m-%d" %}
    {% assign metafield_date_show = product.metafields.meta.street_date | date: "%d/%m/%Y" %}
    {% if metafield_date > system_date %}
      <p>Prodotto acquistabile con Carta Cultura a partire dal  {{ metafield_date_show }}</p>
    {% else %}
      <p>Prodotto acquistabile con Carta Cultura</p>
    {% endif %}
{% else %}
  <p>No date is set in the metafield.</p>
{% endif %}  
</div>  
