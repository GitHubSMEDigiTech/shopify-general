{% doc %}
  @prompt
    Devo mostrare 2 collezioni che ho appena creato
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-pair-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-pair-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-collection-pair-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-size: 26px;
    line-height: 1.2;
  }

  .ai-collection-pair-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-pair-{{ ai_gen_id }}__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-pair-{{ ai_gen_id }}__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-collection-pair-{{ ai_gen_id }}__media img,
  .ai-collection-pair-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-pair-{{ ai_gen_id }}__title {
    margin: 12px 0 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-collection-pair-{{ ai_gen_id }}__card:focus-visible {
    outline: 2px solid {{ settings.accent_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 600px) {
    .ai-collection-pair-{{ ai_gen_id }}__inner {
      width: 100%;
    }

    .ai-collection-pair-{{ ai_gen_id }}__grid {
      gap: {{ block.settings.gap | divided_by: 2 }}px;
    }

    .ai-collection-pair-{{ ai_gen_id }}__heading {
      font-size: 22px;
    }
  }
{% endstyle %}

<div class="ai-collection-pair-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-pair-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-pair-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-collection-pair-{{ ai_gen_id }}__grid">
      {% for i in (1..2) %}
        {% assign collection_key = 'collection_' | append: i %}
        {% assign selected_collection = block.settings[collection_key] %}
        {% if selected_collection != blank %}
          <a class="ai-collection-pair-{{ ai_gen_id }}__card" href="{{ selected_collection.url }}" aria-label="{{ selected_collection.title | escape }}">
            <span class="ai-collection-pair-{{ ai_gen_id }}__media">
              {% if selected_collection.image %}
                <img src="{{ selected_collection.image | image_url: width: 900 }}" alt="{{ selected_collection.image.alt | default: selected_collection.title | escape }}" loading="lazy" width="{{ selected_collection.image.width }}" height="{{ selected_collection.image.height }}">
              {% elsif selected_collection.products.first.featured_image %}
                {% assign collection_image = selected_collection.products.first.featured_image %}
                <img src="{{ collection_image | image_url: width: 900 }}" alt="{{ collection_image.alt | default: selected_collection.title | escape }}" loading="lazy" width="{{ collection_image.width }}" height="{{ collection_image.height }}">
              {% else %}
                <span class="ai-collection-pair-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</span>
              {% endif %}
            </span>
            <h3 class="ai-collection-pair-{{ ai_gen_id }}__title">{{ selected_collection.title | escape }}</h3>
          </a>
        {% else %}
          <div class="ai-collection-pair-{{ ai_gen_id }}__card">
            <span class="ai-collection-pair-{{ ai_gen_id }}__media"><span class="ai-collection-pair-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</span></span>
            <p class="ai-collection-pair-{{ ai_gen_id }}__title">Seleziona una collezione</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Due collezioni",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Scopri le collezioni"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Prima collezione"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Seconda collezione"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Larghezza desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spazio tra le collezioni",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titolo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Testo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Sfondo segnaposto",
      "default": "#f1f1f1"
    }
  ],
  "presets": [
    {
      "name": "Due collezioni"
    }
  ],
  "tag": null,
  "class": "two-collections-block"
}
{% endschema %}